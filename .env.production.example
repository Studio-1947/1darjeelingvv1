# Copy this to `.env` in the repo root on the VPS (NOT committed — already
# gitignored). Used by docker-compose.prod.yml for the postgres and backend
# services. TLS is handled by the VPS's system Nginx + Certbot, not by
# anything in this file — see README's "Production deployment" section.
#
# Every change_me_* placeholder below MUST be replaced. The backend validates
# its config at startup and refuses to boot with APP_ENV=production if any
# secret is unset, left at a development default, or still a change_me_*
# placeholder — so a forgotten value fails the deploy loudly instead of
# silently shipping a publicly-known secret.

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_to_a_long_random_password
POSTGRES_DB=one_darjeeling
# DATABASE_URL is computed automatically by docker-compose.prod.yml from the
# three vars above (postgres://$POSTGRES_USER:$POSTGRES_PASSWORD@postgres:5432/$POSTGRES_DB)
# — you don't need to set it here.

# --- Backend ---
PORT=8000
JWT_SECRET=change_me_to_a_long_random_secret
APP_ENV=production
# Start with mocked payments so the site can go live before Razorpay is ready; checkout completes
# instantly and no money moves. Flip to false only once the three Razorpay values below are filled
# in — the backend refuses to start with MOCK_PAYMENTS=false and any of them missing, rather than
# failing at checkout in front of a paying customer.
MOCK_PAYMENTS=true
# Whether a confirmed booking messages the guest and the host. Like MOCK_PAYMENTS, this has NO
# default under APP_ENV=production — the backend refuses to boot without it. For months every
# production booking silently notified nobody (INVESTIGATION.md §6.A), so an operator now has to
# say which behaviour they want.
#
# NOTE: this is only half the requirement. With MESSAGING_PROVIDER=mock below, notifications are
# attempted and delivered nowhere; the server logs a loud error about exactly that at startup.
# Real delivery needs a real provider AND its per-message template IDs (see the MSG91 block).
NOTIFY_BOOKINGS=true
# How long an unpaid homestay booking holds its dates against other guests, in minutes. Long
# enough to finish a Razorpay checkout, short enough that an abandoned tab frees the room again.
# Optional — defaults to 15.
BOOKING_HOLD_MINUTES=15
# Comma-separated list of allowed origins. Same-origin requests (browser
# calling /api on the same domain that served the page) never need CORS at
# all, so this only matters for any external caller hitting the API directly.
CORS_ORIGINS=https://onedarjeeling.duckdns.org

# --- Razorpay (all three required when MOCK_PAYMENTS=false) ---
# See README → "Razorpay setup" for where each of these comes from.
# Dashboard → Account & Settings → API Keys. Must be rzp_live_* when APP_ENV=production;
# an rzp_test_* key is rejected at startup so test keys can't quietly reach real customers.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Settings → Webhooks → the "Secret" field you set when creating the webhook.
# A DIFFERENT value from RAZORPAY_KEY_SECRET above. Without it the app cannot verify webhook
# deliveries, and payments where the customer closed the tab are charged but never settled.
RAZORPAY_WEBHOOK_SECRET=

# --- Admin ---
# One-time secret required by POST /api/admin/bootstrap to create the first
# DB-backed admin. Generate a random value and use it once, then it's safe
# to leave in place (bootstrap refuses once any admin exists).
ADMIN_BOOTSTRAP_SECRET=change_me_to_a_long_random_secret
# Hardcoded admin login (POST /api/auth/admin/login). Change the password
# from this placeholder before going live.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_to_a_strong_password

# --- Error reporting ---
# Optional; both default to off, and with no DSN nothing leaves this box. Reports errors thrown by
# a RUNNING server — it cannot report a server that failed to boot, so it does not replace an
# external uptime check on /api/health. Payloads are scrubbed (backend/src/lib/scrub.ts).
# FRONTEND_SENTRY_DSN is baked into the JS bundle at build time, so changing it needs a rebuild.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
FRONTEND_SENTRY_DSN=
# The label errors are filed under. Defaults to APP_ENV, which is `production` on BOTH deployed
# stacks — so the staging one must override it here or its errors are indistinguishable from real
# incidents. On onedarjeeling.duckdns.org (now staging), set: SENTRY_ENVIRONMENT=staging
SENTRY_ENVIRONMENT=

# --- Messaging / OTP delivery ---
# `mock` means OTPs are NOT delivered and the 123456 universal code is accepted, so anyone
# can log in as any phone number. That is intentional for a pre-launch staging deployment and
# the server logs a loud error about it at startup — but it must not be left this way once
# real users exist. Set a real provider and supply its credentials below.
# Options: mock | whatsapp | interakt | msg91.  `whatsapp` (Meta direct) is the launch
# choice — no DLT queue. `interakt` is the same thing through a BSP; `msg91` is SMS and needs DLT.
MESSAGING_PROVIDER=mock

# Required when MESSAGING_PROVIDER=msg91 (startup fails without them).
# Dashboard -> API -> Auth Key, and the approved OTP template's ID.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Booking notification templates. Required only when NOTIFY_BOOKINGS=true AND
# MESSAGING_PROVIDER=msg91 — startup fails if any is missing, rather than discovering it at the
# first confirmed booking. Indian SMS rules mean each transactional message needs its own
# DLT-approved template registered in the MSG91 dashboard; these are their IDs.
#   guest  — "Your booking at {listing} is confirmed for {stay}. Host: {host}."
#   host   — "New confirmed booking at {listing}: {guest} ({guest_phone}), {stay}, {guests} guest(s)."
#   cancel — "Your booking at {listing} for {stay} has been cancelled. {refund}"
MSG91_BOOKING_CONFIRMED_GUEST_TEMPLATE_ID=
MSG91_BOOKING_CONFIRMED_HOST_TEMPLATE_ID=
MSG91_BOOKING_CANCELLED_GUEST_TEMPLATE_ID=

# --- WhatsApp Cloud API (MESSAGING_PROVIDER=whatsapp) ------------------------
# Talks to Meta directly, no aggregator. WhatsApp is OTT, not SMS, so DLT registration does not
# apply — which is the whole reason to prefer it here. Full walkthrough: docs/WHATSAPP_SETUP.md.
#
# WHATSAPP_ACCESS_TOKEN must be a SYSTEM USER token. The one on the app dashboard's API Setup page
# is temporary and dies in ~24 hours, which shows up later as "login stopped working overnight".
# The provider warns at boot if the token looks short-lived.
#
# WHATSAPP_PHONE_NUMBER_ID is the numeric id shown beside the number in WhatsApp Manager, NOT the
# phone number itself.
#
# The language code must match the template exactly: a template created as `en` and sent as
# `en_US` fails with "Template name does not exist in the translation".
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=one_darjeeling_login
WHATSAPP_TEMPLATE_LANGUAGE=en
# Pinned deliberately: Meta ships breaking changes between Graph versions.
WHATSAPP_API_VERSION=v21.0

# Required when NOTIFY_BOOKINGS=true AND MESSAGING_PROVIDER=whatsapp. UTILITY templates, one per
# message. Placeholders are positional and are filled in the order src/lib/notifications.ts passes
# them — write the template body to match that file, not the other way round.
WHATSAPP_BOOKING_CONFIRMED_GUEST_TEMPLATE=
WHATSAPP_BOOKING_CONFIRMED_HOST_TEMPLATE=
WHATSAPP_BOOKING_CANCELLED_GUEST_TEMPLATE=

# Days added to BOTH sides of a referral when an invite code is redeemed at signup. The app has
# always advertised "+3 months", so 90 is the default; it is a variable because the number is a
# marketing decision, not a code change. Optional.
#
# There is deliberately no provider-side reward: `provider_paid` is a boolean with no expiry to
# extend, so "1 month free on your ₹99 plan" cannot be honoured until the plan gains a renewal
# model. The app no longer promises it.
REFERRAL_REWARD_DAYS=90

# --- Interakt (MESSAGING_PROVIDER=interakt) ---------------------------------
# WhatsApp through a Meta Business Solution Provider instead of Meta directly. Same messages and
# the same Meta-approved templates as MESSAGING_PROVIDER=whatsapp — Interakt just holds the
# WhatsApp account and the number for you, so the Cloud API setup (number registration, two-step
# PIN, system-user token, template submissions) happens in their console rather than yours. You
# pay a per-message margin for that, and you add one more company between you and delivery.
#
# Still no DLT: this is WhatsApp, not SMS.
#
# INTERAKT_API_KEY is the key from Interakt's Developer Settings. It is ALREADY base64 and goes
# after "Basic" verbatim — encoding it a second time is the usual first mistake and shows up as a
# bare 401 with nothing else to go on.
INTERAKT_API_KEY=
INTERAKT_OTP_TEMPLATE=one_darjeeling_login
INTERAKT_TEMPLATE_LANGUAGE=en

# Interakt takes the country code and the subscriber number as separate fields, unlike every
# other provider here. Numbers on the configured code are split automatically; a number carrying
# a DIFFERENT country code is refused rather than guessed at, because guessing where a country
# code ends does not fail loudly — it sends someone's login code to a stranger abroad.
INTERAKT_COUNTRY_CODE=+91

# Required when NOTIFY_BOOKINGS=true AND MESSAGING_PROVIDER=interakt. The template names as they
# appear in Interakt after syncing them from Meta. Placeholder order is positional and must match
# src/lib/notifications.ts — see docs/WHATSAPP_TEMPLATES.md.
INTERAKT_BOOKING_CONFIRMED_GUEST_TEMPLATE=
INTERAKT_BOOKING_CONFIRMED_HOST_TEMPLATE=
INTERAKT_BOOKING_CANCELLED_GUEST_TEMPLATE=

# --- Store-review sign-in ---------------------------------------------------
# Google Play and Apple both require working credentials for their reviewer, and sign-in here is
# an SMS OTP to a phone the reviewer does not hold. "We could not access the app" is one of the
# commonest rejections, and the tempting shortcut — leaving MESSAGING_PROVIDER=mock — hands
# 123456 to the entire internet.
#
# Set both and EXACTLY ONE number may sign in with a fixed code. Nothing is dispatched for that
# number, so it costs no SMS and spends nothing from the daily budget. Set neither and the
# feature does not exist.
#
# REVIEW_OTP must be at least 10 characters and not a guessable run; the server refuses to boot
# otherwise. It never expires and the verify rate limiter is per-process, so length is what
# protects it. Generate it, do not invent it:
#     openssl rand -base64 18
#
# Unset both once the app is published and the reviewer is done. The server logs at every boot
# that this is on, so it is not forgotten quietly.
REVIEW_PHONE=
REVIEW_OTP=

OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# Daily ceilings on OTP sends, counted in the database so a redeploy does not hand out a fresh
# budget. This is the cost control on real SMS: without it the per-minute limits still allow one
# number 4,320 messages a day, and rotating numbers is free. Optional; defaults shown. If either
# is ever reached, find out why before raising it — reaching them is a signal, not a capacity
# problem.
OTP_MAX_SENDS_PER_PHONE_PER_DAY=10
OTP_MAX_SENDS_PER_DAY=1000

# --- Database backups ---
# The db-backup sidecar in docker-compose.prod.yml / docker-compose.in.yml. Both are optional and
# shown here at their defaults. See deploy/VPS-RUNBOOK.md §7.1 — in particular the part about
# copying the dumps OFF this box, which is not automated.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14

# --- MinIO ---
# Root credentials for the MinIO container itself (see docker-compose.prod.yml). Unless you create
# separate least-privilege service accounts in the MinIO console, MINIO_ACCESS_KEY/SECRET_KEY below
# should be set to these SAME values — the backend just needs *a* credential that can read/write
# both buckets, and the root user is the simplest one that works out of the box.
MINIO_ROOT_USER=change_me_to_a_minio_admin_username
MINIO_ROOT_PASSWORD=change_me_to_a_long_random_password
# Internal compose network address — MinIO has no published host port (see docker-compose.prod.yml
# comments), so the backend must reach it via the Docker service name, never localhost/127.0.0.1.
MINIO_ENDPOINT=http://minio:9000
# Credentials the backend authenticates to MinIO with. Match MINIO_ROOT_USER/PASSWORD above unless
# you've created a separate service account. The backend refuses to boot with APP_ENV=production if
# these are left at the minioadmin/minioadminpassword dev defaults.
MINIO_ACCESS_KEY=change_me_to_a_minio_admin_username
MINIO_SECRET_KEY=change_me_to_a_long_random_password
# PUBLIC bucket — listing images. Served to browsers directly; must have a public-read policy
# (the backend bootstraps this automatically on first upload). Do not point this at the same
# bucket as MINIO_KYC_BUCKET below.
MINIO_BUCKET=one-darjeeling
# The public origin browsers use to fetch uploaded listing images — combined with MINIO_BUCKET as
# ${MINIO_PUBLIC_URL}/${MINIO_BUCKET}/<key>. This MUST be your real public site origin (nginx
# proxies this path to MinIO — see deploy/nginx/app.conf), NOT MinIO's own host:port. A
# localhost/127.0.0.1 value here would mean every uploaded image is unreachable to real users; the
# backend refuses to boot with APP_ENV=production if it detects one.
MINIO_PUBLIC_URL=https://your-domain.tld
# PRIVATE bucket — government ID documents (Aadhaar/PAN/licence) uploaded during provider KYC. NO
# public-read policy is ever applied to this bucket, and nginx has no route to it (see
# deploy/nginx/app.conf) — it is reachable only through the authenticated backend proxy
# GET /api/providers/kyc/:id/file. Never reuse this bucket name for anything public-facing.
MINIO_KYC_BUCKET=one-darjeeling-kyc
