# =============================================================================
#  .env for the 1darjeeling.in stack  (docker-compose.in.yml)
# =============================================================================
#
# Copy to `.env` in /var/www/1darjeeling-in on the VPS. NOT committed — gitignored.
#
# WHY THIS FILE EXISTS SEPARATELY FROM .env.production.example
# ------------------------------------------------------------
# The generic example is written for the onedarjeeling.duckdns.org stack, so it ships with that
# stack's CORS origin and a `https://your-domain.tld` placeholder for MinIO. Copying it verbatim
# to this stack is what took 1darjeeling.in's backend down for 25 hours in August 2026: every
# `change_me_*` was left in place, the backend refused to boot, and `/api` served 502 on every
# path while the site's HTML kept loading fine — so the failure looked like nothing at all from
# the outside. This file has the domain-specific values already correct, so the only thing left
# to do is fill in secrets.
#
# HOW TO FILL IT IN
# -----------------
# Every `GENERATE_ME` below needs its own DISTINCT value. Reusing one secret across variables
# means one leak compromises all of them.
#
#   for n in POSTGRES_PASSWORD JWT_SECRET ADMIN_BOOTSTRAP_SECRET MINIO_ROOT_PASSWORD; do
#     echo "$n=$(openssl rand -hex 32)"
#   done
#
# The backend validates all of this at boot and refuses to start on anything unset, left at a
# development default, or still reading `change_me*`/`GENERATE_ME`. That is deliberate — a
# loud failure at deploy time beats silently shipping a publicly-known secret.

# --- Postgres ---------------------------------------------------------------
# ⚠️ POSTGRES_PASSWORD is read by Postgres ONLY on first initialisation of the data volume, and
# stored there. Changing it here on an already-running stack does NOT change the database, and
# the backend will then fail with `password authentication failed` — which reads like a
# completely different bug. To rotate it on a live stack, change the database FIRST:
#
#   docker exec -it 1darjeeling_in_postgres \
#     psql -U postgres -c "ALTER USER postgres WITH PASSWORD '<new>';"
#
# ...then set the same value here and restart the backend. Non-destructive, no data loss.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=GENERATE_ME
POSTGRES_DB=one_darjeeling
# DATABASE_URL is computed by docker-compose.in.yml from the three values above — don't set it.

# --- Backend ----------------------------------------------------------------
PORT=8000
APP_ENV=production
JWT_SECRET=GENERATE_ME

# Payments stay simulated until Razorpay is activated: checkout completes instantly and no money
# moves. No default in production — the backend refuses to boot without an explicit value, so
# "are we charging real money?" can never be an unset variable.
MOCK_PAYMENTS=true

# Whether a confirmed booking messages the guest and the host. Also has NO default in production.
# For months every production booking notified nobody and nothing said so (INVESTIGATION.md §6.A).
#
# NOTE: with MESSAGING_PROVIDER=mock below, notifications are attempted and delivered NOWHERE —
# the server logs a loud error about exactly that at startup. Real delivery needs a real provider
# AND a DLT-approved template per message (see the MSG91 block).
NOTIFY_BOOKINGS=true

# How long an unpaid homestay booking holds its dates against other guests, in minutes.
# Optional; default 15.
BOOKING_HOLD_MINUTES=15

# This stack's own domain — NOT the duckdns one. Same-origin browser calls never need CORS, so
# this only governs external callers hitting the API directly.
CORS_ORIGINS=https://1darjeeling.in

# --- Razorpay (all three required when MOCK_PAYMENTS=false) -----------------
# Leave empty while MOCK_PAYMENTS=true. See README → "Razorpay setup" for where each comes from,
# and note that live keys need the dashboard switched to Live Mode and the webhook RE-CREATED
# there (test-mode webhooks do not carry over).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Admin ------------------------------------------------------------------
# One-time secret for POST /api/admin/bootstrap, which creates the first DB-backed admin.
# Safe to leave in place after use — bootstrap refuses once any admin exists.
ADMIN_BOOTSTRAP_SECRET=GENERATE_ME
# The admin console login (POST /api/auth/admin/login). Unlike the secrets above you will type
# this one regularly, so make it strong but usable — a password manager entry, not a hex blob.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=GENERATE_ME

# --- Messaging / OTP delivery -----------------------------------------------
# `mock` delivers nothing and accepts the universal code 123456, so ANYONE CAN LOG IN AS ANY
# PHONE NUMBER. That is a deliberate pre-launch state and the server logs a loud error about it,
# but it must not survive contact with real users.
MESSAGING_PROVIDER=mock

# Required when MESSAGING_PROVIDER=msg91 (startup fails without them).
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Required when NOTIFY_BOOKINGS=true AND MESSAGING_PROVIDER=msg91. Indian SMS rules mean each
# transactional message needs its own DLT-approved template, so each gets its own id.
MSG91_BOOKING_CONFIRMED_GUEST_TEMPLATE_ID=
MSG91_BOOKING_CONFIRMED_HOST_TEMPLATE_ID=
MSG91_BOOKING_CANCELLED_GUEST_TEMPLATE_ID=

OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# --- MinIO ------------------------------------------------------------------
# MINIO_ACCESS_KEY/SECRET_KEY are what the BACKEND authenticates with; MINIO_ROOT_USER/PASSWORD
# are the MinIO container's own root credentials. Unless you create a separate service account in
# the MinIO console, set each pair to the SAME values — a mismatch means every image upload fails.
MINIO_ROOT_USER=onedarjeeling_in
MINIO_ROOT_PASSWORD=GENERATE_ME
MINIO_ACCESS_KEY=onedarjeeling_in
MINIO_SECRET_KEY=GENERATE_ME_SAME_AS_MINIO_ROOT_PASSWORD

# Internal compose address. MinIO publishes no host port, so the backend must reach it by service
# name — never localhost.
MINIO_ENDPOINT=http://minio:9000

# ⚠️ The quiet one. This is baked into every uploaded image URL as
# ${MINIO_PUBLIC_URL}/${MINIO_BUCKET}/<key>, and nginx proxies that path to MinIO. The startup
# check only rejects *localhost* values, so the `https://your-domain.tld` placeholder from the
# generic example BOOTS FINE and then silently makes every photo unreachable. It must be this
# stack's real public origin.
MINIO_PUBLIC_URL=https://1darjeeling.in

# PUBLIC bucket — listing images, served straight to browsers.
MINIO_BUCKET=one-darjeeling
# PRIVATE bucket — Aadhaar/PAN/licence scans from provider KYC. Never given a public-read policy
# and unreachable through nginx; only the authenticated backend proxy can read it. Never point
# this at a public-facing bucket name.
MINIO_KYC_BUCKET=one-darjeeling-kyc

# --- Error reporting ---
# Both are OPTIONAL and both default to off: with no DSN, nothing leaves this box.
#
# This covers errors thrown by a RUNNING server. It cannot report a server that never started —
# which is exactly what happened in the 25-hour outage — so it does NOT replace an external uptime
# check on https://1darjeeling.in/api/health. See README "Monitoring" for that half.
#
# Payloads are scrubbed before send (backend/src/lib/scrub.ts): Authorization headers, phone
# numbers, OTPs, uploaded documents and query-string values are replaced, and stack-frame local
# variables are dropped wholesale. That matters because this platform holds Aadhaar/PAN scans.
SENTRY_DSN=
# Sampling rate for performance traces, 0 to 1. Leave at 0 — tracing samples ordinary successful
# requests, which is a continuous stream of URLs rather than the exceptional events worth watching.
SENTRY_TRACES_SAMPLE_RATE=0

# Browser-side DSN. Use a SEPARATE Sentry project from the backend — otherwise a noisy browser
# extension buries your server errors. This one is baked into the JS bundle at image build time
# (CRA cannot read env at runtime), so CHANGING IT REQUIRES A REBUILD, not just a restart:
#   docker compose -f docker-compose.in.yml up -d --build nginx
# A DSN is not a secret; it is a write-only ingestion endpoint and is visible in the bundle by design.
FRONTEND_SENTRY_DSN=

# --- Database backups -------------------------------------------------------
# The db-backup sidecar in docker-compose.in.yml. Both optional, shown at their defaults.
# See deploy/VPS-RUNBOOK.md §7.1 — especially the part about copying dumps OFF this box, which
# is a manual step. On-host backups do not survive losing the host.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
